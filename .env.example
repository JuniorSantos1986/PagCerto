# URL pública da API Express (Render/Railway/Fly/Cloud Run).
# Sem isso o frontend chama /api no mesmo host (útil no dev local com proxy).
VITE_API_URL=https://sua-api.exemplo.com

# Origens autorizadas a chamar a API (separadas por vírgula).
# Em produção a API não libera CORS se esta variável estiver vazia.
CORS_ORIGINS=https://pagcerto-a5ed4.web.app,https://pagcerto-a5ed4.firebaseapp.com

# Backend Firestore
USE_FIRESTORE=1
FIREBASE_PROJECT_ID=pagcerto-a5ed4

# Credenciais do Firebase Admin: use UMA das opções.
# 1) Arquivo JSON (local):
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json
# 2) Conteúdo JSON em variável (Render/Railway/Fly):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"pagcerto-a5ed4",...}

# Porta do servidor Express (o host normalmente injeta)
PORT=3001
