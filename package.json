{
  "name": "gestor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "Gestão de despesas mensais com calendário, recorrências e compartilhamento somente leitura.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "migrate:firestore": "node scripts/migrate-to-firestore.js",
    "migrate:postgres": "node scripts/migrate-to-postgres.js",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting,firestore"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
